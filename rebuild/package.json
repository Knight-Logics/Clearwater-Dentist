{
  "name": "clearwater-dentist-rebuild",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pages": "node scripts/extract-pages.mjs",
    "assets": "node scripts/download-assets.mjs",
    "assets:css": "node scripts/download-css-assets.mjs",
    "build": "node scripts/extract-pages.mjs && node scripts/download-assets.mjs && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "fix": "node scripts/fix-missing-assets.mjs && node scripts/apply-rebuild-fixes.mjs",
    "pages:deploy": "node scripts/fix-missing-assets.mjs && node scripts/apply-rebuild-fixes.mjs && node scripts/prepare-pages.mjs",
    "serve": "npx --yes serve dist -l 3457",
    "screenshot": "node scripts/screenshot-compare.mjs",
    "screenshot:qa": "node scripts/capture-screenshots.mjs",
    "verify:fullbleed": "node scripts/verify-fullbleed.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
